<?xml version="1.0" encoding="utf-8"?>
<!-- Settings Sub-menu with tab navigation -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsMenuContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:clickable="false"
    android:focusable="false">

    <!-- Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/tab_atmosphere"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Atmosphere"
            android:textSize="12sp"
            android:backgroundTint="#0066AA" />

        <Button
            android:id="@+id/tab_sensor"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="Sensor"
            android:textSize="12sp"
            android:backgroundTint="#444444" />

        <Button
            android:id="@+id/tab_filter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Filter"
            android:textSize="12sp"
            android:backgroundTint="#444444" />

    </LinearLayout>

    <!-- Divider below tabs -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#00FFFF"
        android:layout_marginBottom="8dp" />

    <!-- Content Area - contains all sections, only one visible at a time -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Atmosphere Section -->
        <include
            android:id="@+id/section_atmosphere"
            layout="@layout/settings_atmosphere"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Sensor Section -->
        <include
            android:id="@+id/section_sensor"
            layout="@layout/settings_sensor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Filter Section -->
        <include
            android:id="@+id/section_filter"
            layout="@layout/settings_filter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
