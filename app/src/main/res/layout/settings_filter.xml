<?xml version="1.0" encoding="utf-8"?>
<!-- Filter Settings Section (Madgwick filter configuration) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filter_section"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:gravity="center">

    <!-- Placeholder content - filter settings coming soon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Madgwick Filter"
        android:textColor="#00FFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter settings coming soon"
        android:textColor="#888888"
        android:textSize="14sp"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="The Madgwick filter will fuse IMU and\nmagnetometer data for orientation."
        android:textColor="#666666"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingTop="8dp" />

</LinearLayout>
