<?xml version="1.0" encoding="utf-8"?>
<!-- Sensor Diagnostics Section -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/sensor_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Status Summary -->
        <TextView
            android:id="@+id/sensor_status_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No sensor data"
            android:textColor="#FFAA00"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <!-- IMU Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#22FFFFFF"
            android:padding="6dp"
            android:layout_marginBottom="6dp">

            <!-- IMU Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="IMU"
                    android:textColor="#00FFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                
                <TextView
                    android:id="@+id/imu_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- Hz"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Accelerometer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">
                
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="Accel:"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                
                <TextView
                    android:id="@+id/imu_accel_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="X: -- g  Y: -- g  Z: -- g"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Gyroscope -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp">
                
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="Gyro:"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                
                <TextView
                    android:id="@+id/imu_gyro_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="X: -- °/s  Y: -- °/s  Z: -- °/s"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- IMU Temperature -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp">
                
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="Temp:"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                
                <TextView
                    android:id="@+id/imu_temp_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-- °C"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Magnetometer Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#22FFFFFF"
            android:padding="6dp"
            android:layout_marginBottom="6dp">

            <!-- MAG Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Magnetometer"
                    android:textColor="#00FFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                
                <TextView
                    android:id="@+id/mag_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- Hz"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Magnetic Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">
                
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="Field:"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                
                <TextView
                    android:id="@+id/mag_field_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="X: -- G  Y: -- G  Z: -- G"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- MAG Temperature -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp">
                
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="Temp:"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                
                <TextView
                    android:id="@+id/mag_temp_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-- °C"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Barometer Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#22FFFFFF"
            android:padding="6dp"
            android:layout_marginBottom="6dp">

            <!-- BARO Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Barometer"
                    android:textColor="#00FFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                
                <TextView
                    android:id="@+id/baro_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- Hz"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Pressure -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">
                
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="Press:"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                
                <TextView
                    android:id="@+id/baro_pressure_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-- Pa  (-- inHg)"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- BARO Temperature -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp">
                
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="Temp:"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                
                <TextView
                    android:id="@+id/baro_temp_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-- °C"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Humidity Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#22FFFFFF"
            android:padding="6dp"
            android:layout_marginBottom="6dp">

            <!-- HUM Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Humidity"
                    android:textColor="#00FFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                
                <TextView
                    android:id="@+id/hum_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- Hz"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Humidity Value -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">
                
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="RH:"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                
                <TextView
                    android:id="@+id/hum_humidity_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-- %"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- HUM Temperature -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp">
                
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="Temp:"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                
                <TextView
                    android:id="@+id/hum_temp_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-- °C"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Time Sync Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#22FFFFFF"
            android:padding="6dp">

            <!-- TIME Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Time Sync"
                    android:textColor="#00FFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                
                <TextView
                    android:id="@+id/time_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- Hz"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Time Offset -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp">
                
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="Offset:"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                
                <TextView
                    android:id="@+id/time_offset_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-- ms"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- GPS Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp">
                
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="GPS:"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                
                <TextView
                    android:id="@+id/time_gps_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
