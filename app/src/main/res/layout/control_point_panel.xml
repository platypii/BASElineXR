<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#DD000000"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FlySight Control Point"
        android:textColor="#00FFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- Status Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#22FFFFFF"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device Status"
            android:textColor="#FFFF00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <!-- Connection Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Connection:"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/connection_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="Disconnected"
                android:textColor="#FF8888"
                android:textSize="16sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Device Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mode:"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/device_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="---"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Firmware Version -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Firmware:"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/firmware_version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="---"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Device ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Device ID:"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/device_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="---"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Pinned Device (Name + MAC combined) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pinned:"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/pinned_device"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:text="None"
                android:textColor="#88FF88"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:ellipsize="middle"
                android:singleLine="true" />

            <Button
                android:id="@+id/unpin_button"
                android:layout_width="0dp"
                android:layout_weight="0.5"
                android:layout_height="28dp"
                android:text="Unpin"
                android:textSize="12sp"
                android:background="#884444"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GNSS Runtime Settings"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Model:"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <Button
                android:id="@+id/gnss_model_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#446688"
                android:text="&lt;"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:padding="0dp" />

            <TextView
                android:id="@+id/gnss_model_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:text="Portable"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/gnss_model_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#446688"
                android:text="&gt;"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:padding="0dp" />

            <Button
                android:id="@+id/set_gnss_model_button"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.6"
                android:layout_marginStart="4dp"
                android:background="#336644"
                android:text="Set"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rate:"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <Button
                android:id="@+id/gnss_rate_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#446688"
                android:text="&lt;"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:padding="0dp" />

            <TextView
                android:id="@+id/gnss_rate_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center"
                android:text="10 Hz"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/gnss_rate_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#446688"
                android:text="&gt;"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:padding="0dp" />

            <Button
                android:id="@+id/set_gnss_rate_button"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.6"
                android:layout_marginStart="4dp"
                android:background="#336644"
                android:text="Set"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Mode Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Set Mode:"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <Button
                android:id="@+id/set_sleep_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="32dp"
                android:text="Sleep"
                android:textSize="12sp"
                android:background="#446688"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/set_active_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="32dp"
                android:text="Active"
                android:textSize="12sp"
                android:background="#668844"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/show_raw_button"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="32dp"
                android:text="Show"
                android:textSize="12sp"
                android:background="#664488"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ext Sync:"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/ext_sync_value"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1.4"
                android:layout_marginEnd="4dp"
                android:background="#223344"
                android:fontFamily="monospace"
                android:hint="unix sec"
                android:inputType="number"
                android:paddingHorizontal="8dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#88AAAAAA"
                android:textSize="14sp" />

            <Button
                android:id="@+id/set_ext_sync_button"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="0.8"
                android:background="#336644"
                android:text="Stamp"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- BLE Divider Settings Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#22FFFFFF"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BLE Divider Settings"
            android:textColor="#FFFF00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <!-- Divider Status Display -->
        <TextView
            android:id="@+id/divider_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dividers: ---"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingBottom="8dp" />

        <!-- Divider Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/set_dividers_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_bg"
                android:text="Set All = 1"
                android:textColor="#88FF88"
                android:textSize="16sp" />

            <Button
                android:id="@+id/get_dividers_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_bg"
                android:text="Get Dividers"
                android:textColor="#88CCFF"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sensor Configuration Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#22FFFFFF"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor Configuration"
            android:textColor="#FFFF00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <!-- Column Headers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Sensor"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <TextView
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="ODR"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <TextView
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:text="Divider"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:gravity="center" />

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Rate"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Baro Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Baro"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sensor_baro_odr"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/sensor_baro_div_dec"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:text="−"
                android:textSize="16sp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:padding="0dp" />

            <TextView
                android:id="@+id/sensor_baro_divider"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#FFFF88"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:gravity="center" />

            <Button
                android:id="@+id/sensor_baro_div_inc"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:text="+"
                android:textSize="16sp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:padding="0dp" />

            <TextView
                android:id="@+id/sensor_baro_rate"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#88FF88"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/sensor_baro_set"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/button_bg"
                android:text="Set"
                android:textColor="#88FF88"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Hum Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Hum"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sensor_hum_odr"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/sensor_hum_div_dec"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:text="−"
                android:textSize="16sp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:padding="0dp" />

            <TextView
                android:id="@+id/sensor_hum_divider"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#FFFF88"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:gravity="center" />

            <Button
                android:id="@+id/sensor_hum_div_inc"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:text="+"
                android:textSize="16sp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:padding="0dp" />

            <TextView
                android:id="@+id/sensor_hum_rate"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#88FF88"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/sensor_hum_set"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/button_bg"
                android:text="Set"
                android:textColor="#88FF88"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Accel Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Accel"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sensor_accel_odr"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/sensor_accel_div_dec"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:text="−"
                android:textSize="16sp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:padding="0dp" />

            <TextView
                android:id="@+id/sensor_accel_divider"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#FFFF88"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:gravity="center" />

            <Button
                android:id="@+id/sensor_accel_div_inc"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:text="+"
                android:textSize="16sp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:padding="0dp" />

            <TextView
                android:id="@+id/sensor_accel_rate"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#88FF88"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/sensor_accel_set"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/button_bg"
                android:text="Set"
                android:textColor="#88FF88"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Gyro Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Gyro"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sensor_gyro_odr"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/sensor_gyro_div_dec"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:text="−"
                android:textSize="16sp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:padding="0dp" />

            <TextView
                android:id="@+id/sensor_gyro_divider"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#FFFF88"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:gravity="center" />

            <Button
                android:id="@+id/sensor_gyro_div_inc"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:text="+"
                android:textSize="16sp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:padding="0dp" />

            <TextView
                android:id="@+id/sensor_gyro_rate"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#88FF88"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/sensor_gyro_set"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/button_bg"
                android:text="Set"
                android:textColor="#88FF88"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Mag Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="2dp">

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="Mag"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sensor_mag_odr"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/sensor_mag_div_dec"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:text="−"
                android:textSize="16sp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:padding="0dp" />

            <TextView
                android:id="@+id/sensor_mag_divider"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#FFFF88"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:gravity="center" />

            <Button
                android:id="@+id/sensor_mag_div_inc"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:text="+"
                android:textSize="16sp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:padding="0dp" />

            <TextView
                android:id="@+id/sensor_mag_rate"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="---"
                android:textColor="#88FF88"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/sensor_mag_set"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/button_bg"
                android:text="Set"
                android:textColor="#88FF88"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Note about ODR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: ODR is read-only (set via config.txt)"
            android:textColor="#888888"
            android:textSize="12sp"
            android:paddingTop="4dp" />
    </LinearLayout>

    <!-- Device Info Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#22FFFFFF"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device Info"
            android:textColor="#FFFF00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <!-- Info Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/get_fw_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_bg"
                android:text="Get FW Ver"
                android:textColor="#88CCFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/get_device_id_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_bg"
                android:text="Get Device ID"
                android:textColor="#88CCFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Config Query Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/get_sensor_odrs_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_bg"
                android:text="Get ODRs"
                android:textColor="#FFCC44"
                android:textSize="14sp" />

            <Button
                android:id="@+id/get_rates_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_bg"
                android:text="Get Rates"
                android:textColor="#FFCC44"
                android:textSize="14sp" />

            <Button
                android:id="@+id/get_ble_budget_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_bg"
                android:text="Get BLE BW"
                android:textColor="#FFCC44"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Mag Cal Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/get_mag_cal_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_bg"
                android:text="Get MagCal"
                android:textColor="#FFCC44"
                android:textSize="14sp" />

            <Button
                android:id="@+id/reset_mag_cal_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/button_bg"
                android:text="Reset MagCal"
                android:textColor="#FF8844"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Response Log Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#22FFFFFF"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Response Log"
            android:textColor="#FFFF00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/response_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:text="---"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:maxLines="20" />
    </LinearLayout>

</LinearLayout>
